<Window x:Class="TrueInjector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TrueInjector"
        Icon="pack://application:,,,/syringe.ico"
        Width="1080"
        Height="706"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource Size.Body}"
        Foreground="{StaticResource B.TextPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshCommand}" />
        <KeyBinding Modifiers="Control" Key="I" Command="{Binding InjectCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ======================= Caption bar ======================= -->
        <DockPanel Grid.Row="0" Background="{StaticResource B.Rail}" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource B.LogoTile}">
                    <Path Data="{StaticResource IcSyringe}"
                          Style="{StaticResource Glyph}"
                          Stroke="{DynamicResource B.AccentInk}"
                          StrokeThickness="1.9"
                          Width="20" Height="20"
                          Stretch="Uniform" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Font.Display}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource B.TextPrimary}">
                        <Run Text="TRUE" /><Run Text="INJECTOR" Foreground="{DynamicResource B.Accent}" />
                    </TextBlock>
                    <TextBlock FontSize="9" Foreground="{DynamicResource B.TextTertiary}" Margin="0,-2,0,0">
                        Precision DLL injection
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="Minimize">
                    <Path Data="{StaticResource IcMinimize}" Style="{StaticResource SmallGlyph}" Width="14" Height="14" Stroke="{DynamicResource B.TextSecondary}" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="Maximize">
                    <Path x:Name="CaptionShape" Data="{StaticResource IcMaximize}" Style="{StaticResource SmallGlyph}" Width="14" Height="14" Stroke="{DynamicResource B.TextSecondary}" />
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Click="CloseClick" ToolTip="Close">
                    <Path Data="{StaticResource IcClose}" Style="{StaticResource SmallGlyph}" Width="14" Height="14" Stroke="{DynamicResource B.TextSecondary}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ======================= Body ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource B.Rail}" BorderBrush="{StaticResource B.StrokeSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="24,0,0,14"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="10"
                               Foreground="{DynamicResource B.TextTertiary}"
                               Text="v2.0.0 · x64" />

                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ClipToBounds="True">
                            <Rectangle x:Name="NavPill"
                                       Height="40"
                                       RadiusX="8" RadiusY="8"
                                       Fill="{DynamicResource B.Active}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Top"
                                       Margin="0,0,0,0" />
                            <ListBox x:Name="NavList"
                                     Style="{StaticResource FlatList}"
                                     Background="Transparent"
                                     SelectionChanged="NavSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Height="24">
                                            <Path x:Name="Icon"
                                                  Data="{Binding Icon}"
                                                  Style="{StaticResource Glyph}"
                                                  Width="18"
                                                  Height="18"
                                                  Stroke="{DynamicResource B.TextSecondary}" />
                                            <TextBlock x:Name="Label"
                                                       Text="{Binding Label}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontFamily="{StaticResource Font.Display}"
                                                       Foreground="{DynamicResource B.TextSecondary}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource B.AccentBright}" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Page host + toasts -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <ContentControl x:Name="PageHost" Margin="24,20,24,16" Focusable="False" />

                <StackPanel x:Name="ToastHost"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,8"
                            MaxWidth="380" />
            </Grid>
        </Grid>

        <!-- ======================= Footer ======================= -->
        <Border Grid.Row="2" Background="{StaticResource B.Rail}" BorderBrush="{StaticResource B.StrokeSoft}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False" Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource B.Amber}" Margin="0,1,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadyStatus}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource B.Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlockedStatus}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource B.Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="StatusText"
                               FontSize="11.5"
                               Foreground="{DynamicResource B.TextSecondary}"
                               Text="{Binding CanInjectHint, Mode=OneWay}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource B.TextTertiary}"
                           Text="{Binding ProcessStats, Mode=OneWay}" />

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenGitHubCommand}"
                        ToolTip="github.com/ZygoteCode/TrueInjector"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcGithub}" Style="{StaticResource FillGlyph}" Width="13" Height="13" Fill="{DynamicResource B.TextSecondary}" />
                        <TextBlock Text="GitHub" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
