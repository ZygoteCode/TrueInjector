<UserControl x:Class="TrueInjector.UI.Pages.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,0,18" LastChildFill="False">
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeading}" Text="Activity console" />
                <TextBlock Style="{StaticResource PageSubheading}" Margin="0,4,0,0"
                           Text="Everything the injector does, stamped as it happens." />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource OutlineButton}"
                    Command="{Binding ClearActivityCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IcTrash}" Style="{StaticResource SmallGlyph}" Width="14" Height="14" Stroke="{DynamicResource B.TextSecondary}" />
                    <TextBlock Text="Clear" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="FeedList"
                     Style="{StaticResource FlatList}"
                     ItemsSource="{Binding Activity}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding TimeLabel, Mode=OneWay}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource B.TextTertiary}"
                                       VerticalAlignment="Top"
                                       Margin="4,2,10,0" />

                            <Rectangle Grid.Column="1" Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Margin="0,2,10,0" Fill="{DynamicResource B.Stroke}" x:Name="KindBar" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message, Mode=OneWay}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource B.TextSecondary}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Success">
                                <Setter TargetName="KindBar" Property="Fill" Value="{DynamicResource B.Green}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="KindBar" Property="Fill" Value="{DynamicResource B.Red}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Action">
                                <Setter TargetName="KindBar" Property="Fill" Value="{DynamicResource B.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
