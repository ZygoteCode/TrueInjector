<UserControl x:Class="TrueInjector.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,18">
            <TextBlock Style="{StaticResource PageHeading}" Text="About TrueInjector" />
            <TextBlock Style="{StaticResource PageSubheading}" Margin="0,4,0,0"
                       Text="A focused injection bench for Windows x64 — sharp where it counts." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource B.LogoTile}">
                                    <Path Data="{StaticResource IcSyringe}"
                                          Style="{StaticResource Glyph}"
                                          Stroke="{DynamicResource B.AccentInk}"
                                          StrokeThickness="1.9"
                                          Width="28" Height="28"
                                          Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="16" FontWeight="Bold">
                                        <Run Text="TRUE" /><Run Text="INJECTOR" Foreground="{DynamicResource B.Accent}" />
                                    </TextBlock>
                                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource B.TextTertiary}" Margin="0,2,0,0"
                                               Text="version 2.0.0 · WPF · x64" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Built on the battle-tested internals of the original tool — every allocation, write, execution and handle technique carried over one-to-one — with a fully animated WPF front-end on top."
                                       Foreground="{DynamicResource B.TextSecondary}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="QUICK START" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource B.AccentBright}" />
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12.5" Margin="0,4,0,0"
                                           Text="1. Pick the target process on the Inject page." />
                                <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12.5" Margin="0,4,0,0"
                                           Text="2. Drop or browse for the payload DLL." />
                                <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12.5" Margin="0,4,0,0"
                                           Text="3. Tune the loader chain under Techniques — or trust the defaults." />
                                <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12.5" Margin="0,4,0,0"
                                           Text="4. Hit Inject. Watching a process instead? Arm the Watchdog." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="COMPANION MODULES" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource B.AccentBright}" />
                            <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="Manual mapping and thread hijacking load native helpers on demand:" />
                            <Border Style="{StaticResource InnerCard}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="ManualMapper.dll" Style="{StaticResource MonoText}" Foreground="{DynamicResource B.TextPrimary}" />
                                    <TextBlock Text="ThreadHijacker.dll" Style="{StaticResource MonoText}" Foreground="{DynamicResource B.TextPrimary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Foreground="{DynamicResource B.TextTertiary}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Keep them beside TrueInjector.exe. Standard and native loading need nothing extra." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                        <StackPanel>
                            <TextBlock Text="PROJECT" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource B.AccentBright}" />

                            <Button HorizontalAlignment="Left"
                                    Style="{StaticResource OutlineButton}"
                                    Click="OpenRepository">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcGithub}" Style="{StaticResource FillGlyph}" Width="15" Height="15" Fill="{DynamicResource B.TextSecondary}" />
                                    <TextBlock Text="github.com/ZygoteCode/TrueInjector" Margin="9,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12" Margin="0,14,0,0"
                                       Text="Created by ZygoteCode. Distributed under the MIT license." />
                            <TextBlock Foreground="{DynamicResource B.TextTertiary}" FontSize="11.5" Margin="0,4,0,0"
                                       Text="Injecting into protected third-party software may violate its terms — know the rules of whatever you target." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
