<UserControl x:Class="TrueInjector.UI.Pages.WatchdogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,18">
            <TextBlock Style="{StaticResource PageHeading}" Text="Startup watchdog" />
            <TextBlock Style="{StaticResource PageSubheading}" Margin="0,4,0,0"
                       Text="Have TrueInjector pull the trigger the moment a process appears." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WatchdogArmed, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Arm the watchdog"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource B.TextPrimary}" />
                                <TextBlock Text="Watches the system for your target and injects as soon as it spawns."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource B.TextSecondary}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TARGET PROCESS NAME" />
                                <TextBox Style="{StaticResource FramedTextBox}"
                                         Tag="for example: notepad"
                                         Text="{Binding WatchdogTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="240" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Style="{StaticResource Badge}"
                                    Background="{DynamicResource B.GreenDim}"
                                    BorderBrush="#1F5C48"
                                    Padding="10,5"
                                    Visibility="{Binding WatchdogArmed, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource B.Green}" Margin="0,0,7,0" />
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource B.Green}" Text="ARMED" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Randomize payload" FontSize="12.5" Foreground="{DynamicResource B.TextPrimary}" />
                                    <TextBlock Text="Fresh path + DOS stub per shot" FontSize="10.5" Foreground="{DynamicResource B.TextTertiary}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RandomizePayload, Mode=TwoWay}" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide payload file" FontSize="12.5" Foreground="{DynamicResource B.TextPrimary}" />
                                    <TextBlock Text="Drops with hidden + read-only attrs" FontSize="10.5" Foreground="{DynamicResource B.TextTertiary}" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HidePayload, Mode=TwoWay}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="HOW IT FIRES" Style="{StaticResource FieldLabel}" />
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12" Margin="0,3,0,0"
                                       Text="· Polls the system every 500 ms for the target name." />
                            <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12" Margin="0,3,0,0"
                                       Text="· Validates the payload architecture against the new process." />
                            <TextBlock Foreground="{DynamicResource B.TextSecondary}" FontSize="12" Margin="0,3,0,0"
                                       Text="· Fires one shot with the current techniques, then shuts down." />
                        </StackPanel>

                        <Separator Background="{DynamicResource B.StrokeSoft}" Margin="0,14,0,12" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="PAYLOAD IN USE" />
                        <TextBlock Text="{Binding DllFileName}"
                                   Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource B.AccentBright}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DllPath}" />
                        <TextBlock Foreground="{DynamicResource B.TextTertiary}"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   Text="Change it any time on the Inject page — the watchdog always uses the latest selection." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
