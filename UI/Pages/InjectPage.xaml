<UserControl x:Class="TrueInjector.UI.Pages.InjectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,18">
            <TextBlock Style="{StaticResource PageHeading}" Text="Prepare the injection" />
            <TextBlock Style="{StaticResource PageSubheading}" Margin="0,4,0,0"
                       Text="Pick a live process, load the payload, fire when ready." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Target process ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TARGET PROCESS" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Rescan the system (Ctrl+R)">
                            <Path x:Name="RefreshGlyph"
                                  Data="{StaticResource IcRefresh}"
                                  Stroke="{DynamicResource B.TextSecondary}"
                                  Width="17" Height="17"
                                  Stretch="Uniform"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Glyph}">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360"
                                                                             Duration="0:0:0.85"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                             To="0"
                                                                             Duration="0:0:0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchBox}"
                                 Tag="Filter by name or PID…"
                                 Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Path Data="{StaticResource IcSearch}"
                              Style="{StaticResource SmallGlyph}"
                              Stroke="{DynamicResource B.TextTertiary}"
                              HorizontalAlignment="Left"
                              Margin="9,0,0,0"
                              IsHitTestVisible="False" />
                    </Grid>

                    <ListBox Grid.Row="2"
                             x:Name="ProcessList"
                             Style="{StaticResource FlatList}"
                             MinHeight="320"
                             ItemsSource="{Binding ProcessesView}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <Border x:Name="AvatarBox"
                                                CornerRadius="8"
                                                Background="{Binding AvatarBrushDim}">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding AvatarBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="IconBox" CornerRadius="8" Background="#141B24" Visibility="Collapsed">
                                            <Image Source="{Binding Icon}"
                                                   Width="22"
                                                   Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="NameText"
                                                   Text="{Binding ProcessName}"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource B.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource B.TextTertiary}">
                                            <Run Text="PID " /><Run Text="{Binding DisplayId, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Path x:Name="RowChevron"
                                          Grid.Column="2"
                                          Data="{StaticResource IcChevron}"
                                          Style="{StaticResource SmallGlyph}"
                                          Stroke="{DynamicResource B.Accent}"
                                          Visibility="Hidden"
                                          VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter TargetName="AvatarBox" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="IconBox" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource B.AccentBright}" />
                                        <Setter TargetName="RowChevron" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,48,0,0"
                               Foreground="{DynamicResource B.TextTertiary}"
                               FontSize="12"
                               Text="Nothing matches that filter.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ProcessList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="3"
                               Margin="0,10,0,0"
                               Style="{StaticResource MonoText}"
                               Text="Live view — rescans every few seconds while idle" />
                </Grid>
            </Border>

            <!-- ============ Payload ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="PAYLOAD" />

                    <Border Grid.Row="1"
                            x:Name="DropZone"
                            Style="{StaticResource InnerCard}"
                            BorderBrush="{DynamicResource B.Stroke}"
                            MinHeight="110"
                            Cursor="Hand"
                            Background="{DynamicResource B.Rail}"
                            MouseLeftButtonUp="DropZoneClicked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="DropPrompt">
                            <Path Data="{StaticResource IcDownload}"
                                  Style="{StaticResource Glyph}"
                                  Stroke="{DynamicResource B.TextTertiary}"
                                  Width="22" Height="22"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Drop a DLL here or browse"
                                       Foreground="{DynamicResource B.TextTertiary}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0" x:Name="PayloadMeta">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDll}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DllFileName}"
                                       FontWeight="SemiBold"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource B.TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DllPath}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Command="{Binding ClearDllCommand}"
                                    ToolTip="Unload payload">
                                <Path Data="{StaticResource IcClose}" Style="{StaticResource SmallGlyph}" Width="13" Height="13" Stroke="{DynamicResource B.TextSecondary}" />
                            </Button>
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,6" Background="{DynamicResource B.AccentDim}" BorderBrush="{DynamicResource B.AccentDeep}">
                                <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource B.AccentBright}" Text="{Binding Inspection.Architecture, FallbackValue='—'}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Inspection.SizeLabel, FallbackValue=''}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Margin="0,0,6,6">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Inspection.ModifiedUtc, StringFormat='modified {0:yyyy-MM-dd HH:mm}', FallbackValue=''}" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding DllPath}"
                                   Style="{StaticResource MonoText}"
                                   Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DllPath}" />
                    </StackPanel>

                    <Button Grid.Row="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource OutlineButton}"
                            Command="{Binding BrowseCommand}"
                            Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcFolder}" Style="{StaticResource SmallGlyph}" Width="15" Height="15" Stroke="{DynamicResource B.TextSecondary}" />
                            <TextBlock Text="Browse…" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,14,0,0">
                        <StackPanel.Resources>
                            <Style x:Key="CloakLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,7,0" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="Randomize" Style="{StaticResource CloakLabel}" ToolTip="Overwrite the DOS stub and relaunch the payload from a randomized folder" />
                        <ToggleButton Style="{StaticResource ToggleSwitch}" Width="38" Height="22" IsChecked="{Binding RandomizePayload, Mode=TwoWay}" />
                        <TextBlock Text="Hide" Style="{StaticResource CloakLabel}" Margin="14,0,7,0" ToolTip="Mark the dropped payload hidden and read-only" />
                        <ToggleButton Style="{StaticResource ToggleSwitch}" Width="38" Height="22" IsChecked="{Binding HidePayload, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Inject action -->
                    <Grid Grid.Row="4" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="InjectButton"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding InjectCommand}"
                                Height="46">
                            <Grid>
                                <StackPanel Orientation="Horizontal" x:Name="IdleContent">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource IcBolt}"
                                          Style="{StaticResource Glyph}"
                                          Fill="{DynamicResource B.AccentInk}"
                                          Stroke="{x:Null}"
                                          Width="17" Height="17" />
                                    <TextBlock Text="Inject payload" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" x:Name="BusyContent" Visibility="Collapsed">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="M12,3 A9,9 0 1 1 3.5,14.5"
                                          Style="{StaticResource SpinnerGlyph}"
                                          Width="16" Height="16" />
                                    <TextBlock Text="Injecting…" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock Grid.Row="1"
                                   Margin="2,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource B.TextTertiary}"
                                   Text="{Binding CanInjectHint, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
