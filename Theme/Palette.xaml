<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TrueInjector design tokens.
        A single cool-dark surface ramp, one azure accent, semantic green/red/amber.
        Radii follow a strict 4px rhythm: 4 / 8 / 12.
    -->

    <Color x:Key="C.Window">#0F1319</Color>
    <Color x:Key="C.Rail">#0C1016</Color>
    <Color x:Key="C.Surface">#151B24</Color>
    <Color x:Key="C.Elevated">#1B2330</Color>
    <Color x:Key="C.Hover">#202A38</Color>
    <Color x:Key="C.Active">#233042</Color>
    <Color x:Key="C.Stroke">#263043</Color>
    <Color x:Key="C.StrokeSoft">#1D2532</Color>
    <Color x:Key="C.TextPrimary">#EAF0F8</Color>
    <Color x:Key="C.TextSecondary">#9CAABD</Color>
    <Color x:Key="C.TextTertiary">#65748A</Color>
    <Color x:Key="C.Accent">#3EA8FF</Color>
    <Color x:Key="C.AccentBright">#66BDFF</Color>
    <Color x:Key="C.AccentDeep">#1D6EB8</Color>
    <Color x:Key="C.AccentInk">#0E1B26</Color>
    <Color x:Key="C.Green">#43D9A3</Color>
    <Color x:Key="C.Red">#FF6D6D</Color>
    <Color x:Key="C.Amber">#FFC46B</Color>

    <SolidColorBrush x:Key="B.Window" Color="{StaticResource C.Window}" />
    <SolidColorBrush x:Key="B.Rail" Color="{StaticResource C.Rail}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Elevated" Color="{StaticResource C.Elevated}" />
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="B.Active" Color="{StaticResource C.Active}" />
    <SolidColorBrush x:Key="B.Stroke" Color="{StaticResource C.Stroke}" />
    <SolidColorBrush x:Key="B.StrokeSoft" Color="{StaticResource C.StrokeSoft}" />
    <SolidColorBrush x:Key="B.TextPrimary" Color="{StaticResource C.TextPrimary}" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="{StaticResource C.TextSecondary}" />
    <SolidColorBrush x:Key="B.TextTertiary" Color="{StaticResource C.TextTertiary}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentBright" Color="{StaticResource C.AccentBright}" />
    <SolidColorBrush x:Key="B.AccentInk" Color="{StaticResource C.AccentInk}" />
    <SolidColorBrush x:Key="B.Green" Color="{StaticResource C.Green}" />
    <SolidColorBrush x:Key="B.Red" Color="{StaticResource C.Red}" />
    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}" />

    <!-- Overlay tints derived from the accent, for chips and quiet highlights -->
    <SolidColorBrush x:Key="B.AccentDim">#173249</SolidColorBrush>
    <SolidColorBrush x:Key="B.GreenDim">#12332A</SolidColorBrush>
    <SolidColorBrush x:Key="B.RedDim">#341B1E</SolidColorBrush>
    <SolidColorBrush x:Key="B.AmberDim">#34281A</SolidColorBrush>

    <LinearGradientBrush x:Key="B.AccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource C.AccentBright}" />
        <GradientStop Offset="1" Color="{StaticResource C.Accent}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.LogoTile" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource C.AccentBright}" />
        <GradientStop Offset="1" Color="{StaticResource C.AccentDeep}" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="E.Card" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000" />
    <DropShadowEffect x:Key="E.Toast" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="E.AccentGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="{StaticResource C.Accent}" />

    <!-- Typography: Segoe UI Variable on Win11, graceful Segoe UI fallback -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <CornerRadius x:Key="R.Chip">4</CornerRadius>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Size.Title">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Size.Section">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Size.Body">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Size.Small">11.5</sys:Double>
</ResourceDictionary>
