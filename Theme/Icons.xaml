    <!-- Clean-up broom for the activity console -->
    <Geometry x:Key="IcTrash">M4.5,7 H19.5 M9.5,7 V5 A1,1 0 0 1 10.5,4 H13.5 A1,1 0 0 1 14.5,5 V7 M6.5,7 L7.3,19 A1.5,1.5 0 0 0 8.8,20.5 H15.2 A1.5,1.5 0 0 0 16.7,19 L17.5,7 M10,10.5 V17 M14,10.5 V17</Geometry>

    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource B.TextSecondary}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FillGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="Stroke" Value="{x:Null}" />
        <Setter Property="Fill" Value="{DynamicResource B.TextSecondary}" />
    </Style>

    <Style x:Key="SmallGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="StrokeThickness" Value="1.7" />
    </Style>
</ResourceDictionary>
